# ==========================================
# Bhatti Chemicals Industry - .gitignore
# ==========================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini

# Editors & IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# Scratch, Temporary & Backup Files
scratch/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~
*.orig

# Server Cache & Logs
cache/
logs/
*.log
error_log
access_log

# Test & Debug Report Dumps
scripts/*_report.txt
scripts/*.log

# Environment & Credentials (if any)
.env
.env.local
.env.*.local
*.sql
*.tar.gz
*.zip
